From 8372c87b597a2f71d65f26a8e3c9dc8b3ab68819 Mon Sep 17 00:00:00 2001
From: Umme Kulsum Tumpa <bsse1307@iit.du.ac.bd>
Date: Sun, 4 Oct 2026 09:49:08 +0600
Subject: [PATCH 2/2] Remove Ollama Cloud models outside the free tier (402 in
 probe)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/evals/agent.py            | 7 +++----
 tests/evals/test_providers.py | 3 ---
 2 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/src/evals/agent.py b/src/evals/agent.py
index e774214..2fbb55e 100644
--- a/src/evals/agent.py
+++ b/src/evals/agent.py
@@ -337,15 +337,14 @@ MODEL_REGISTRY: dict[str, ModelConfig] = {
     "claude-2": ModelConfig("anthropic/claude-2", True, "anthropic"),
     "llama2-70b": ModelConfig("meta-llama/llama-2-70b-chat", True, "openrouter"),
     "mixtral-8x7b": ModelConfig("mistralai/mixtral-8x7b-instruct", True, "openrouter"),
-    # Ollama Cloud (ids from GET https://ollama.com/api/tags). Keys become
+    # Ollama Cloud FREE-tier models only (probe 2026-10-04; glm-5.3-flash,
+    # deepseek-v4.1-flash, minimax-m2.7 returned 402 "not included in your free
+    # usage" and are deliberately absent). Ids from GET https://ollama.com/api/tags. Keys become
     # results-filename prefixes: no "/", "_" or ":".
     "ollama-gpt-oss-20b": ModelConfig("gpt-oss:20b", True, "ollama_cloud"),
     "ollama-gpt-oss-120b": ModelConfig("gpt-oss:120b", True, "ollama_cloud"),
     "ollama-nemotron-3-nano-30b": ModelConfig("nemotron-3-nano:30b", True, "ollama_cloud"),
     "ollama-gemma4-31b": ModelConfig("gemma4:31b", True, "ollama_cloud"),
-    "ollama-glm-5.3-flash": ModelConfig("glm-5.3-flash", True, "ollama_cloud"),
-    "ollama-deepseek-v4.1-flash": ModelConfig("deepseek-v4.1-flash", True, "ollama_cloud"),
-    "ollama-minimax-m2.7": ModelConfig("minimax-m2.7", True, "ollama_cloud"),
     # Local Ollama server (no key)
     "ollama-local-qwen3-8b": ModelConfig("qwen3:8b", True, "ollama_local"),
 }
diff --git a/tests/evals/test_providers.py b/tests/evals/test_providers.py
index 24ad1c2..a00c99a 100644
--- a/tests/evals/test_providers.py
+++ b/tests/evals/test_providers.py
@@ -25,9 +25,6 @@ OLLAMA_CLOUD_MODELS = {
     "ollama-gpt-oss-120b": "gpt-oss:120b",
     "ollama-nemotron-3-nano-30b": "nemotron-3-nano:30b",
     "ollama-gemma4-31b": "gemma4:31b",
-    "ollama-glm-5.3-flash": "glm-5.3-flash",
-    "ollama-deepseek-v4.1-flash": "deepseek-v4.1-flash",
-    "ollama-minimax-m2.7": "minimax-m2.7",
 }
 
 
